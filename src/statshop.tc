import statShopIcon;
import util;
import treegens;
import stats;
import settingsMenu;
import statsMenu;

namespace statShop {
    function openMenu() {
        line inv = inventory.tiledMenu(4);

        if(global "%uuid stats"["tree_type"] >= 25) {
            if(player.y >= 33) {
                line city_icon = item("gold_block");
                city_icon = city_icon.setName(s"<gold>The City");
                city_icon = city_icon.setLore([
                    s"<gray>The City is a global hub for all players",
                    s"<gray>to meet, communicate, and trade.",
                    s"",
                    s"<yellow>Click to warp!" 
                ]);
                city_icon = city_icon.setTag("warp", "city");
                inv.setItem(36, city_icon);
            } else {
                line city_icon = item("grass_block");
                city_icon = city_icon.setName(s"<green>Home");
                city_icon = city_icon.setLore([
                    s"<gray>Your Home Base with your tree.",
                    s"",
                    s"<yellow>Click to warp!" 
                ]);
                city_icon = city_icon.setTag("warp", "home");
                inv.setItem(36, city_icon);
            }
        }

        line lbIcon = item("cherry_hanging_sign");
        lbIcon = lbIcon.setName(s"<gold>Leaderboard");
        lbIcon = lbIcon.setTag("leaderboard_icon", 1);
        if(!var.exists(treeTypeLeaderboard)) {
            declare saved treeTypeLeaderboard: dict[num] = saved "leaderboard" as dict[num];
        }
        if(!var.exists(leaderboardNames)) {
            declare saved leaderboardNames: dict[str] = {};
        }
        if(!var.exists(trueLogLeaderboard)) {
            declare saved trueLogLeaderboard: dict[num] = {};
        }
        if(!var.exists(chatWinLeaderboard)) {
            declare saved chatWinLeaderboard: dict[num] = {};
        }
        if(!var.exists(weatherDonationLeaderboard)) {
            declare saved weatherDonationLeaderboard: dict[num] = {};
        }
        if(!var.exists(drillDonationLeaderboard)) {
            declare saved drillDonationLeaderboard: dict[num] = {};
        }
        if(!var.exists(playtimeLeaderboard)) {
            declare saved playtimeLeaderboard: dict[num] = {};
        }
        lbIcon = lbIcon.setLore(leaderboardLore());
        inv.setItem(35, lbIcon);

        line settingsIcon = item("iron_ingot");
        settingsIcon = settingsIcon.setName(s"<#cccccc>Settings");
        settingsIcon = settingsIcon.setTag("settings_menu", 1);
        inv.setItem(34, settingsIcon);

        line updateIcon = item("lectern");
        updateIcon = updateIcon.setName(s"<#cccccc>Update Log");
        updateIcon = updateIcon.setTag("update_menu", 1);
        inv.setItem(33, updateIcon);


        line slot = 1;
        for(line iconKey of namespace.getKeys(statShopIcon)) {
            line levelReq = statShopIcon[iconKey].levelReq;
            if(global "%uuid stats"["tree_type"] < levelReq) {
                continue;
            }

            line name = statShopIcon[iconKey].name;
            line material = statShopIcon[iconKey].material;
            line cost = statShopIcon[iconKey].basePrice * num.exponent(
                statShopIcon[iconKey].priceScaling, 
                saved "%uuid statShop"[iconKey]
            );

            line level = saved "%uuid statShop"[iconKey];

            line priceBrackets = statShopIcon[iconKey].priceBrackets;
            if(!priceBrackets.sizeEquals(0)) {
                cost = priceBrackets[level + 1];
            }

            line polynomialPrice = statShopIcon[iconKey].polynomialPrice;
            if(!polynomialPrice.sizeEquals(0)) {
                cost = 0;
                line exponent: num = 0;
                for(line poly of polynomialPrice.reverse() as list[num]) {
                    cost += (poly * (level + 1).exponent(exponent));
                    exponent += 1;
                }
            }
            line prestigePoint = statShopIcon[iconKey].prestigeEvery;

            line maxLevel = statShopIcon[iconKey].maxLevel;
            if(priceBrackets.len() != 0) {
                maxLevel = priceBrackets.len();
            }
            if(level >= maxLevel) {
                cost = -1;
            }

            line costFmt = util.numberFormat(cost);
            line icon = item("acacia_boat");
            icon = icon.setModel(material);
            icon = icon.setName(s"<green>%var(name)");
            icon = icon.addLore(s"<dark_gray>Level %var(level)<#333333>/%var(maxLevel)");
            if(!statShopIcon[iconKey].description.sizeEquals(0)) {
                icon = icon.addLore(s"<gray>");
                for(line loreLine of statShopIcon[iconKey].description) {
                    icon = icon.addLore(s"<gray>%var(loreLine)");
                }
            }
            if(prestigePoint != -1 && cost != -1 && ((level + 1) % prestigePoint == 0) && level <= 50) {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<green><bold>PRESTREEIGE!");
                icon = icon.addLore(s"<gray>Buying this upgrade will <red>reset");
                icon = icon.addLore(s"<gray>your current logs.");
                icon = icon.setTag("prestige", 1);
            }
            if(cost != -1) {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<gray>Costs <green>%var(costFmt) <gray>logs to upgrade.");
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow>Click to upgrade!");
            } else {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow><bold>MAXED!");
            }
            icon = icon.setTag("upgrade", iconKey);
            icon = icon.setTag("cost", cost);

            inv.setItem(slot, icon);
            
            slot++;
        }

        //I'm putting this after the loop since it keeps disappearing and I don't know why
        line statsIcon = item("writable_book");
        statsIcon = statsIcon.setName(s"<#cccccc>Stats");
        statsIcon = statsIcon.setTag("stats_menu", 1);
        inv.setItem(32, statsIcon);

        inv.openForSelection();
    }

    function clickStatShopIcon() {
        if(event.clickedSlotItem.hasTag("stats_menu")) {
            statsMenu.openMenu();
        }
        if(event.clickedSlotItem.hasTag("update_menu")) {
            updateMenu.openMenu();
        }
        if(event.clickedSlotItem.hasTag("settings_menu")) {
            settingsMenu.openMenu();
        }
        if(event.clickedSlotItem.hasTag("leaderboard_icon")) {
            declare global "%uuid leaderboardType": num += 1;
            openMenu();
        }
        line iconKey = event.clickedSlotItem.getTag("upgrade") as str;
        if(namespace.has_member(statShopIcon, iconKey)) {
            line cost = event.clickedSlotItem.getTag("cost") as num;
            if(cost == -1) {
                return;
            }
            if(saved "%uuid logs" >= num.floor(cost)) {
                saved "%uuid logs" -= cost;
                saved "%uuid statShop"[iconKey] += 1;

                if(iconKey == "treeType") {
                    openMenu();
                    if(global "%uuid treeRegenerating" == 1) {
                        return;
                    }
                    game.cloneRegion(
                        loc(0, 3, 0),
                        loc(50, 38, 50),
                        loc(0, 3, 0),
                        global "%uuid roomPos".shiftAllAxes(-25, -3, -25),
                        ignoreAir = "False"
                    );
                    start treegens.growForPlayer();
                }


                if(event.clickedSlotItem.hasTag("prestige")) {
                    saved "%uuid logs" = 0;
                }
            }
            openMenu();
            stats.computeStats();
        }
    }

    function leaderboardLore(): list[txt] {
        for(line p of game.plotPlayerUUIDs) {
            select playersByName(p);
            treeTypeLeaderboard[p] = global "%uuid stats"["tree_type"];
            chatWinLeaderboard[p] = saved "%uuid chat_wins";
            weatherDonationLeaderboard[p] = saved "%uuid donatedToWeatherMachine";
            trueLogLeaderboard[p] = saved "%uuid true_logs";
            drillDonationLeaderboard[p] = saved "%uuid donatedDrillLogUnits";
            playtimeLeaderboard[p] = (saved "%uuid playtime" / 20 / 60);
            leaderboardNames[p] = selected.name.clearFormatting();
            select reset;
        }

        treeTypeLeaderboard = treeTypeLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        chatWinLeaderboard = chatWinLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        trueLogLeaderboard = trueLogLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        weatherDonationLeaderboard = weatherDonationLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        playtimeLeaderboard = playtimeLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        drillDonationLeaderboard = drillDonationLeaderboard.sort("type" = "Sort by Value", order = "Descending");
        
        line txts: list[txt] = [];
        line idx = 1;

        line lbType = "treeTypeLeaderboard";
        if(global "%uuid leaderboardType" == 1) {
            line lbType = "chatWinLeaderboard";
            txts.append(s"<gray>Type: <yellow>Chat Wins");
            txts.append(s"");
        } else if(global "%uuid leaderboardType" == 2) {
            line lbType = "trueLogLeaderboard";
            txts.append(s"<gray>Type: <yellow>True Logs Broken");
            txts.append(s"");
        } else if(global "%uuid leaderboardType" == 3) {
            line lbType = "weatherDonationLeaderboard";
            txts.append(s"<gray>Type: <yellow>Weather Machine Donation Amount");
            txts.append(s"");
        } else if(global "%uuid leaderboardType" == 4) {
            line lbType = "playtimeLeaderboard";
            txts.append(s"<gray>Type: <yellow>Playtime (in Minutes)");
            txts.append(s"");
        } else if(global "%uuid leaderboardType" == 5) {
            line lbType = "drillDonationLeaderboard";
            txts.append(s"<gray>Type: <yellow>Drill Donation Leaderboard");
            txts.append(s"");
        } else if(global "%uuid leaderboardType" == 6 || global "%uuid leaderboardType" == 0) {
            global "%uuid leaderboardType" = 0;
            txts.append(s"<gray>Type: <yellow>Tree Type Level");
            txts.append(s"");
        }

        for(line uuid, line value of saved "%var(lbType)" as dict[num]) {
            line name = leaderboardNames[uuid];
            line level = treeTypeLeaderboard[uuid];
            line tag = loops.createChatTag(level);
            line fmtValue = util.numberFormat(value);
            txts.append(s"<dark_gray>%var(idx). %var(tag) <white>%var(name): <green>%var(fmtValue)");
            idx++;
            if(idx > 20) {
                break;
            }
        }

        txts.append(s"");
        txts.append(s"<yellow>Click to switch leaderboards!");

        return txts;
    }
}
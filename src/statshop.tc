namespace statShopIcon {
    schema: namespace {
        material: str;
        name: str;
        stat: str;
        basePrice: num;
        amount: num = 1;
        priceScaling: num = 1.15;
        maxLevel: num = 50;
    };
}

namespace statShopIcon.sweep {
    material = "iron_axe";
    name = "Sweep";
    stat = "sweep";
    basePrice = 40;
    priceScaling = 1.3;
}

namespace statShopIcon.logFortune {
    material = "spruce_sapling";
    name = "Fortune";
    stat = "fortune";
    amount = 0.06;
    basePrice = 15;
    priceScaling = 1.15;
}

namespace statShopIcon.jumpHeight {
    material = "feather";
    name = "Jump Height";
    stat = "jump_height";
    amount = 1;
    basePrice = 200;
    priceScaling = 3;
    maxLevel = 4;
}

namespace statShopIcon.abilityCooldown {
    material = "clock";
    name = "Ability Cooldown";
    stat = "ability_cooldown";
    amount = 1;
    basePrice = 200;
    priceScaling = 2;
    maxLevel = 10;
}

import statShopIcon;

namespace statShop {
    function openMenu() {
        line inv = inventory.tiledMenu(1);

        line slot = 1;
        for(line iconKey of namespace.getKeys(statShopIcon)) {
            line name = statShopIcon[iconKey].name;
            line material = statShopIcon[iconKey].material;
            line cost = statShopIcon[iconKey].basePrice * num.exponent(
                statShopIcon[iconKey].priceScaling, 
                saved "%uuid statShop"[iconKey]
            );

            line level = saved "%uuid statShop"[iconKey];
            line icon = item("acacia_boat");
            icon = icon.setModel(material);
            icon = icon.setName(s"<green>%var(name)");
            icon = icon.addLore(s"<dark_gray>Level %var(level)");
            icon = icon.addLore(s"");
            icon = icon.addLore(s"<gray>Costs <green>%var(cost) <gray>logs to upgrade.");
            icon = icon.addLore(s"");
            icon = icon.addLore(s"<yellow>Click to upgrade!");
            icon = icon.setTag("upgrade", iconKey);

            inv.setItem(slot, icon);
            
            slot++;
        }

        inv.openForSelection();
    }

    function clickStatShopIcon() {
        line iconKey = event.clickedSlotItem.getTag("upgrade") as str;
        if(namespace.has_member(statShopIcon, iconKey)) {
            line cost = statShopIcon[iconKey].basePrice * num.exponent(
                statShopIcon[iconKey].priceScaling, 
                saved "%uuid statShop"[iconKey]
            );
            if(saved "%uuid logs" > cost) {
                saved "%uuid logs" -= cost;
                saved "%uuid statShop"[iconKey] += 1;
            }

            openMenu();
        }
    }
}
import treegens;

namespace treegens {
    mega = "mega";
    big = "big";
    medium = "medium";
    small = "small";
    tiny = "tiny";

    process growForPlayer() {
        if(global "%uuid treeRegenerating" == 1) {
            endthread;
        } 

        declare global "%uuid treeRegenerating" = 1;
        wait(20);

        global "%uuid brokenLogs" = [];
        declare global "%uuid blocksToBreak" = treegens.buildOakTree(
            global "%uuid roomPos",
            treegens.mega
        );
        global "%uuid treeRegenerating" = 0;
    }

    function buildOakTree(
        root: loc,
        size: str
    ): list[loc] {
        line log_positions: list[vec];
        line height: num;
        line branchReqs: num;
        line outputPositions: list[loc] = [];
        if(size == tiny) {
            log_positions = [
                vec(0, 0, 0)
            ];
            height = num.random(4, 5);
            branchReqs = 2;
        }  
        if(size == small) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1)
            ];
            height = num.random(6, 9);
            branchReqs = 3;
        }
        if(size == medium) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1)
            ];
            height = num.random(7, 10);
            branchReqs = 3;
        }   
        if(size == big) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1)
            ];
            height = num.random(10, 13);
            branchReqs = 4;
        }
        if(size == mega) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1),
                vec(2, 0, 0),
                vec(-2, 0, 0),
                vec(0, 0, 2),
                vec(0, 0, -2)
            ];
            height = num.random(12, 14);
            branchReqs = 6;
        }   

        for(line i of range(0, height)) {
            for(line offset of log_positions) {
                line added = root.shiftOnVector(offset);
                game.setBlock(item("stripped_oak_wood"), added);
                allPlayers.playSound(snd("Wood Place"), added);
                outputPositions.append(added);
            }
            wait(1);
            root.y += 1;
        }

        root.y -= 1;
        line terminalLength = num.floor(height * 0.6);
        line iterations = 0;
        line branches = 0;
        line yawOffset = num.random(0, 360);
        line yawDiff = 360 / branchReqs;
        repeat {
            wait(1);
            iterations++;
            if(iterations > 50) {
                break;
            }
            if(branches >= branchReqs) {
                break;
            }
            line yaw = yawOffset + (yawDiff * branches);
            line pitch = num.random(-30, 30);
            line rootCopy = root.shiftAllDirections(0, 0, 0);
            rootCopy.pitch += pitch;
            rootCopy.yaw += yaw;
            line targetLoc = rootCopy.shiftInDirection(terminalLength, direction = "Forward");   

            for(line pathPos of path(root, targetLoc, 0.25)) {
                line placed = 0;
                if(game.getBlockMaterial(pathPos) == "air") {
                    placed = 1;
                }
                game.setBlock(item("stripped_oak_wood"), pathPos);
                allPlayers.playSound(snd("Wood Place"), pathPos);
                if(placed == 1) {
                    outputPositions.append(pathPos.align());
                    wait(1);
                }
            }
            branches++;

        }

        outputPositions.removeDuplicates();
        return outputPositions;
    }
}
namespace statShopIcon {
    schema: namespace {
        material: str;
        name: str;
        stat: str;
        basePrice: num = 0;
        amount: num = 1;
        priceScaling: num = 1.15;
        maxLevel: num = 50000000;
        priceBrackets: list[num] = [];
    };
}

namespace statShopIcon.sweep {
    material = "iron_axe";
    name = "Sweep";
    stat = "sweep";
    basePrice = 15;
    priceScaling = 1.125;
}

namespace statShopIcon.logFortune {
    material = "spruce_sapling";
    name = "Fortune";
    stat = "fortune";
    amount = 0.06;
    basePrice = 15;
    priceScaling = 1.9;
}

namespace statShopIcon.treeGrowthSpeed {
    material = "cherry_sapling";
    name = "Tree Growth Speed";
    stat = "tree_growth";
    amount = 1;
    basePrice = 30;
    priceScaling = 1.4;
}

namespace statShopIcon.jumpHeight {
    material = "feather";
    name = "Jump Height";
    stat = "jump_height";
    amount = 1;
    basePrice = 300;
    priceScaling = 2.5;
    maxLevel = 4;
}

namespace statShopIcon.treeType {
    material = "jungle_sapling";
    name = "Tree Type";
    stat = "tree_type";
    amount = 1;
    priceBrackets: list[num] = [
        20, 60, 300, 900, 
        1200, 1800, 2300, 3700, 5000,
        8000, 9000, 11000, 17000, 35000,
        110000, 140000, 180000, 400000, 800000, 
        1_000_000,  1_400_000, 2_400_000, 3_100_000, 3_900_000, 
        4_700_000,  6_300_000, 8_400_000, 11_000_000, 14_000_000, 
        28_000_000,  20_000_000, 35_000_000, 65_000_000, 140_000_000,
        170_000_000, 210_000_000, 340_000_000, 520_000_000, 680_000_000,
        -1
    ];
}

import statShopIcon;
import util;

namespace statShop {
    function openMenu() {
        line inv = inventory.tiledMenu(1);

        line slot = 1;
        for(line iconKey of namespace.getKeys(statShopIcon)) {
            line name = statShopIcon[iconKey].name;
            line material = statShopIcon[iconKey].material;
            line cost = statShopIcon[iconKey].basePrice * num.exponent(
                statShopIcon[iconKey].priceScaling, 
                saved "%uuid statShop"[iconKey]
            );

            line level = saved "%uuid statShop"[iconKey];


            line priceBrackets = statShopIcon[iconKey].priceBrackets;
            if(!priceBrackets.sizeEquals(0)) {
                cost = priceBrackets[level + 1];
            }

            if(level >= statShopIcon[iconKey].maxLevel || (level >= priceBrackets.len() && priceBrackets.len() != 0)) {
                cost = -1;
            }

            line costFmt = util.numberFormat(cost);
            line icon = item("acacia_boat");
            icon = icon.setModel(material);
            icon = icon.setName(s"<green>%var(name)");
            icon = icon.addLore(s"<dark_gray>Level %var(level)");
            if(cost != -1) {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<gray>Costs <green>%var(costFmt) <gray>logs to upgrade.");
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow>Click to upgrade!");
            } else {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow><bold>MAXED!");
            }
            icon = icon.setTag("upgrade", iconKey);
            icon = icon.setTag("cost", cost);

            inv.setItem(slot, icon);
            
            slot++;
        }

        inv.openForSelection();
    }

    function clickStatShopIcon() {
        line iconKey = event.clickedSlotItem.getTag("upgrade") as str;
        if(namespace.has_member(statShopIcon, iconKey)) {
            line cost = event.clickedSlotItem.getTag("cost") as num;
            if(cost == -1) {
                return;
            }
            if(saved "%uuid logs" > cost) {
                saved "%uuid logs" -= cost;
                saved "%uuid statShop"[iconKey] += 1;
            }

            openMenu();
        }
    }
}
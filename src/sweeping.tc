import treegens;
import util;
import trinket;

type log_family: {
    value: num,
    toughness: num,
    name: str
};

extend log_family {
    function constructor(value: num, toughness: num, name: str): log_family {
        return { value: value, toughness: toughness, name: name } as log_family;
    }
}

type falling_block_anim: {
    uuid: str,
    target: loc,
    pitch: num,
    yaw: num,
    roll: num,
    duration: num,
    phase: num,
    ticksLeft: num
};

declare global "%uuid fallingBlocks": list[falling_block_anim];

namespace sweeping {
    // reimplementation of aaxper's algorithm ported to terracotta
    // with treecutting-specific calculations included

    // take 2 arrays A and B
    // put the origin in A
    // get blocks adjacent to A and put it in B if not already in A or B
    // rinse and repeat until you have enough blocks
    function getBlockOrders(
        tier: num,
        origin: loc,
        maxBlocks: num,
        firstStrike: num = 0,
        timberLevel: num = 0
    ): list[list[loc]] {
        // calculate the max blocks based off toughness
        line logFamily = global log_families[num.floor(tier / 5) + 1];
        maxBlocks = maxBlocks - logFamily["toughness"];

        if(maxBlocks > 8) {
            maxBlocks = 8 + ((maxBlocks - 8) * 0.5);
        }
        if(maxBlocks > 16) {
            maxBlocks = 16 + ((maxBlocks - 16) * 0.5);
        }
        if(maxBlocks > 32) {
            maxBlocks = 32 + ((maxBlocks - 32) * 0.5);
        }


        // activate timber skill, done here
        // as to not litter code all over the place
        if(num.random(1, 100) <= timberLevel) {
            if (saved "%uuid timberCount" == 0) {
                saved "%uuid timberCount" == 1;
            } else {
                saved "%uuid timberCount" += 1;
            }
            player.playSound(snd("Axe Strip"), source = "Players");
            maxBlocks = 0;

            for(line bl of global "%uuid blocksToBreak") {
                safeBreak(bl);
                util.fastWait(1/100);
            }
            return [];
        }

        // core algorithm implemented here
        line breakQueue: list[list[loc]] = [];
        line currentBlockList: list[loc] = [origin];
        line breaksNextTick: list[loc] = [];
        line brokenBlocks = [];
        line blocksMined = 0;

        line ls = str.setToString(global woodTypeList);

        while(blocksMined < maxBlocks) {
            if(currentBlockList.sizeEquals(0)) {
                if(breaksNextTick.sizeEquals(0)) {
                    break;
                }

                breakQueue.append(breaksNextTick);
                currentBlockList = breaksNextTick;
                breaksNextTick = [];
            }

            line el = currentBlockList.pop(num.random(1, currentBlockList.len()));
            for(line offset of sweepVecs) {
                line adj = el.shiftAllAxes(offset.x, offset.y, offset.z);
                line mat = game.getBlockMaterial(adj);
                if(!brokenBlocks.contains(adj) && mat != "air" && ls.contains(mat)) {
                    breaksNextTick.append(adj);
                    brokenBlocks.append(adj);
                }   
            }
            blocksMined++;
        }

        return breakQueue;
    }

    // takes a list of list of blocks, flattens them, and breaks them all
    function executeSweep(
        incrementOnBlock: var[num],
        blocks: list[list[loc]]
    ): num {
        line flat = blocks.flatten();
        flat.removeDuplicates();

        line blocksPerTick =  (flat.len() / 10);
        for(line block of flat) {
            safeBreak(block);
            util.fastWait(1/blocksPerTick);
        }
    }

    // takes a flattened list of blocks, and breaks them all
    function executeSweepFlattened(
        incrementOnBlock: var[num],
        blocks: list[loc]
    ): num {
        blocks.removeDuplicates();

        line blocksPerTick =  (blocks.len() / 10);
        for(line block of blocks) {
            safeBreak(block);
            util.fastWait(1/blocksPerTick);
        }
    }

    function calculateGlobalLogMul(): num {
        line logMul = 0;

        if(weatherType == 1) {
            logMul += 0.2;
        }
        if(weatherType == 2) {
            logMul += 0.5;
        }
        if(weatherType == 3) {
            logMul += 0.9;
        }
        if(weatherType == 4) {
            logMul += 1.5;
        }
        if(weatherType == 5) {
            logMul += 2.5;
        }
        if(weatherType == 6) {
            // all of you are going to die
            logMul += 3.5;
        }

        declare global globalTrinketBuff = 0;
        for(line p of game.plotPlayerUUIDs) {
            select playersByName(p);
            for(line rngId of saved "%uuid trinketSelections") {
                // skip if no trinket is selected
                if (rngId == 0) {
                    continue;
                }

                line globalBuff = trinket[saved "%uuid trinketInventory"["%var(rngId)"]["id"]].globalLogValueBonus;
                
                globalTrinketBuff += globalBuff;
            }
            select reset;
        }

        globalTrinketBuff = globalTrinketBuff.exponent(0.9);
        globalTrinketBuff = globalTrinketBuff.round();

        logMul += (globalTrinketBuff / 100);

        declare global "globalLogMul": num = logMul;

        return logMul;
    }

    function calculateLocalLogMul(): num {
        line logMul = 0;
        logMul += global "%uuid stats"["fortune"] / 100;
        logMul += (global "%uuid stats"["combo_str"] * (global "%uuid combo" * 0.002));

        line localTrinketBuff = 0;
        for(line rngId of saved "%uuid trinketSelections") {
            if(rngId == 0) {
                continue;
            }

            localTrinketBuff += trinket[
                saved "%uuid trinketInventory"["%var(rngId)"]["id"]
            ].localLogValueBonus;
        }
        logMul += localTrinketBuff / 100;

        declare global "%uuid logMul": num = logMul;
        declare global "%uuid logValue" = log_families[num.floor(global "%uuid stats"["tree_type"]/5)+1]["value"];
        return logMul;
    }

    // safely breaks a block if it is possible to do so,
    // grants rewards in the process
    function safeBreak(
        block: loc
    ) {
        block = block.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        if(global "%uuid treeRegenerating" == 1) {
            event.cancel();
            return;
        }
        
        line logValue = global "%uuid logValue" * (1 + global "%uuid logMul" + global globalLogMul);

        line mat = game.getBlockMaterial(block);
        if(mat != "air" && mat != "light" && !global "%uuid brokenLogs".contains(block)) {
            global "%uuid brokenLogs".append(block);
            saved "%uuid logs" += logValue;
            declare saved "%uuid cumulativeLogs":num += logValue;
            declare saved "%uuid true_logs" += 1;
        }
        if(saved "%uuid settings"["logEffects"] == "Enabled" || saved "%uuid settings"["logEffects"] == "Particles Only") {
            visualBreak(block);
        } else {
            game.setBlock("air" as item, block);
        }
        
        if(game.cpuUsage * 100 < 40) {
            queueBlockFallAnim(block, mat);
        }


        declare global "%uuid combo": num += 1;

        line brokenSoFar = global "%uuid brokenLogs".len();
        line brokenReq = global "%uuid blocksToBreak".len();
        if(
            brokenSoFar / brokenReq >= 0.9 - (global "%uuid stats"["cutoff_rate"] / 100)
        ) {
            start treeClearAnim(block);
            for(line block2 of global "%uuid blocksToBreak") {
                line mat2 = game.getBlockMaterial(block2);
                if(mat2 != "air" && !global "%uuid brokenLogs".contains(block2)) {
                    global "%uuid brokenLogs".append(block2);
                    saved "%uuid logs" += logValue;
                    saved "%uuid true_logs" += 1;
                    global "%uuid combo": num += 1;
                    if(game.cpuUsage * 100 < 30) {
                        queueBlockFallAnim(block2, mat);
                    }
                }
                if(saved "%uuid settings"["logEffects"] == "Enabled" || saved "%uuid settings"["logEffects"] == "Particles Only") {
                    visualBreak(block2);
                } else {
                    game.setBlock("air" as item, block2);
                }

            }
            player.playSound(snd("Creaking Activate", 1, 0.5), source = "Players");
            start treegens.growForPlayer();
        }
    }

    function visualBreak(
        block2: loc
    ) {
        line mt = game.getBlockMaterial(block2);
        line bs = game.getBlockSound(mt as item, soundType = "Break Sound");
        line pt = par("Block", amount = 20, spreadHoriz = 0.5, spreadVert = 0.5, material = mt);
        player.playSound(bs, block2, source = "Blocks");
        player.displayParticleEffect(pt, block2);
        game.setBlock("air" as item, block2);
    }

    // the square animation made when a tree hit it's cutoff point
    process treeClearAnim(
        pos: loc
    ) {
        line pitch = -90;
        if(default.eyeLocation.y > pos.y) {
            pitch = 90;
        }
        pos = pos.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
        game.spawnTextDisplay(pos, s"☐");
        lastEntity.setTag("owner", "%default");
        line disp = lastEntity.uuid;

        allPlayers.setEntityHidden(disp);
        default.setEntityHidden(disp, hidden = "Disable");

        select entitiesByName(disp);
        selectedEntity.setDisplayRotationFromEulerAngles(pitch, 0, 0);
        selectedEntity.setDisplayBillboard("type" = "Fixed");
        selectedEntity.setTextDisplayBackground("#000000", 0);
        for(line idx of range(0, 100, 10)) {
            selectedEntity.setDisplayInterpolation(1, 0);
            selectedEntity.setTextDisplayTextOpacity((100 - idx) / 2);
            selectedEntity.setDisplayScale(idx * 2, idx * 2, idx * 2);
            line translation = vec(-0.02, 0, -0.13).multiply(idx * 2);
            selectedEntity.setDisplayTranslation(translation);
            wait(1);
        }
        selectedEntity.remove();
        select reset;

    }

    function queueBlockFallAnim(
        block: loc,
        mat: str
    ) {
        if(global "%uuid fallingBlocks".len() <= 480) {
            if(saved "%uuid settings"["logEffects"] == "Disabled" || saved "%uuid settings"["logEffects"] == "Particles Only") {
                return;
            }
            block = block.align(align = "Block center", rotation = "Remove rotation", coords = "All coordinates");
            game.spawnItemDisplay(block, item(mat));
            allPlayers.setEntityHidden(lastEntity.uuid);
            player.setEntityHidden(lastEntity.uuid, hidden = "Disable");
            lastEntity.setTag("owner", "%default");
            line uuid = lastEntity.uuid;

            line xOff = num.random(-2, 2, rounding = "Decimal number");
            line zOff = num.random(-2, 2, rounding = "Decimal number");

            line pitchOff = num.random(-90, 90, rounding = "Decimal number");
            line yawOff = num.random(-90, 90, rounding = "Decimal number");
            line rollOff = num.random(-90, 90, rounding = "Decimal number");

            line tempLoc = block;
            while(game.getBlockMaterial(tempLoc) != "water" && game.getBlockMaterial(tempLoc) != "grass_block") {
                tempLoc.y -= 1;
                if(tempLoc.y < 0) {
                    select entitiesByUUID(uuid);
                    selectedEntity.remove();
                    select reset;
                    return;
                }
            }

            line distDown = num.abs(block.y - tempLoc.y);
            line distTime = num.ceil(distDown * 3);

       
            global "%uuid fallingBlocks".append({
                uuid: uuid,
                target: block.shiftAllAxes(xOff, -distDown, zOff),
                pitch: pitchOff,
                yaw: yawOff,
                roll: rollOff,
                duration: distTime,
                phase: 0,
                ticksLeft: 0
            } as falling_block_anim);
        }
    }

    process runFallingBlockAnims() {
        line stillFalling: list[falling_block_anim] = [];
        for(line anim of global "%uuid fallingBlocks") {
            select entitiesByUUID(anim["uuid"]);
            if(anim["phase"] == 0) {
                entity.setDisplayTeleportDuration(anim["duration"]);
                entity.setDisplayInterpolation(anim["duration"]);
                anim["phase"] = 1;
                stillFalling.append(anim);
            } else if(anim["phase"] == 1) {
                entity.teleport(anim["target"]);
                entity.setDisplayRotationFromEulerAngles(anim["pitch"], anim["yaw"], anim["roll"]);
                anim["phase"] = 2;
                anim["ticksLeft"] = anim["duration"];
                stillFalling.append(anim);
            } else {
                anim["ticksLeft"] = anim["ticksLeft"] - 1;
                if(anim["ticksLeft"] <= 0) {
                    entity.remove();
                } else {
                    stillFalling.append(anim);
                }
            }
            select reset;
        }
        global "%uuid fallingBlocks" = stillFalling;
    }
}
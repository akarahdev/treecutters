namespace statShopIcon {
    schema: namespace {
        material: str;
        name: str;
        stat: str;
        basePrice: num = 0;
        amount: num = 1;
        priceScaling: num = 1.15;
        prestigeEvery: num = -1;
        polynomialPrice: list[num] = [];
        maxLevel: num = 50;
        priceBrackets: list[num] = [];
    };
}

namespace statShopIcon.sweep {
    material = "iron_axe";
    name = "Sweep";
    stat = "sweep";
    basePrice = 15;
    priceScaling = 1.15;
    maxLevel = 100;
}

namespace statShopIcon.logFortune {
    material = "spruce_sapling";
    name = "Fortune";
    stat = "fortune";
    amount = 0.06;
    basePrice = 15;
    priceScaling = 1.9;
}

namespace statShopIcon.treeGrowthSpeed {
    material = "cherry_sapling";
    name = "Tree Growth Speed";
    stat = "tree_growth";
    amount = 1;
    basePrice = 30;
    priceScaling = 1.4;
}

namespace statShopIcon.jumpHeight {
    material = "feather";
    name = "Jump Height";
    stat = "jump_height";
    amount = 1;
    basePrice = 100;
    priceScaling = 1.5;
    maxLevel = 4;
}

namespace statShopIcon.treeType {
    material = "jungle_sapling";
    name = "Tree Type";
    stat = "tree_type";
    prestigeEvery = 5;
    amount = 1;
    // auto-generated via desmos: https://www.desmos.com/calculator/kuar1urjyj
    priceBrackets: list[num] = [45,196,537,962,1561,530,1918,4247,7358,10066,1201,7154,18240,31940,21522,5737,37957,90904,200360,283614,13340,89578,177610,397140,424958,36476,201036,461234,866315,228842,54916,269127,561050,1144020,768148,151444,757708,1937108];
}

import statShopIcon;
import util;
import treegens;

namespace statShop {
    function openMenu() {
        line inv = inventory.tiledMenu(1);

        line slot = 1;
        for(line iconKey of namespace.getKeys(statShopIcon)) {
            line name = statShopIcon[iconKey].name;
            line material = statShopIcon[iconKey].material;
            line cost = statShopIcon[iconKey].basePrice * num.exponent(
                statShopIcon[iconKey].priceScaling, 
                saved "%uuid statShop"[iconKey]
            );

            line level = saved "%uuid statShop"[iconKey];

            line priceBrackets = statShopIcon[iconKey].priceBrackets;
            if(!priceBrackets.sizeEquals(0)) {
                cost = priceBrackets[level + 1];
            }

            line polynomialPrice = statShopIcon[iconKey].polynomialPrice;
            if(!polynomialPrice.sizeEquals(0)) {
                cost = 0;
                line exponent: num = 0;
                for(line poly of polynomialPrice.reverse() as list[num]) {
                    cost += (poly * (level + 1).exponent(exponent));
                    exponent += 1;
                }
            }
            line prestigePoint = statShopIcon[iconKey].prestigeEvery;

            if(
                level >= statShopIcon[iconKey].maxLevel 
                || (level >= priceBrackets.len() && priceBrackets.len() != 0)
            ) {
                cost = -1;
            }

            line costFmt = util.numberFormat(cost);
            line icon = item("acacia_boat");
            icon = icon.setModel(material);
            icon = icon.setName(s"<green>%var(name)");
            icon = icon.addLore(s"<dark_gray>Level %var(level)");
            if(prestigePoint != -1 && cost != -1 && ((level + 1) % prestigePoint == 0)) {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<green><bold>PRESTIGE!");
                icon = icon.addLore(s"<gray>Buying this upgrade will <red>reset");
                icon = icon.addLore(s"<gray>your current logs.");
                icon = icon.setTag("prestige", 1);
            }
            if(cost != -1) {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<gray>Costs <green>%var(costFmt) <gray>logs to upgrade.");
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow>Click to upgrade!");
            } else {
                icon = icon.addLore(s"");
                icon = icon.addLore(s"<yellow><bold>MAXED!");
            }
            icon = icon.setTag("upgrade", iconKey);
            icon = icon.setTag("cost", cost);

            inv.setItem(slot, icon);
            
            slot++;
        }

        inv.openForSelection();
    }

    function clickStatShopIcon() {
        line iconKey = event.clickedSlotItem.getTag("upgrade") as str;
        if(namespace.has_member(statShopIcon, iconKey)) {
            line cost = event.clickedSlotItem.getTag("cost") as num;
            if(cost == -1) {
                return;
            }
            if(saved "%uuid logs" > cost) {
                saved "%uuid logs" -= cost;
                saved "%uuid statShop"[iconKey] += 1;
            }
            if(event.clickedSlotItem.hasTag("prestige")) {
                saved "%uuid logs" = 0;
            }

            openMenu();

            if(iconKey == "treeType") {
                while(global "%uuid treeRegenerating" == 1) {
                    wait();
                }
                game.cloneRegion(
                    loc(0, 6, 0),
                    loc(50, 37, 50),
                    loc(0, 6, 0),
                    global "%uuid roomPos".shiftAllAxes(-25, -1, -25),
                );
                start treegens.growForPlayer();
            }

        }
    }
}
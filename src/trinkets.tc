import util;

namespace trinket {
    schema: namespace {
        center: loc;
        name: str;
        localLogValueBonus: num = 0;
        globalLogValueBonus: num = 0;
        stats: dict[num] = {};
        shopWeight: num = 10;
        cost: num;
        icon: item;
    };
}


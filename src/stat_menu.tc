import statShopIcon;
import trinket;
import statsMenu;
import util;

namespace statsMenu {

    function computeStats() {
        declare local stathash:list[{"tag": str, "name": str, "amount": num}] = [];
        line stats =  global "%uuid stats"; 

        //Here we actually build the hash
        //Right now I only loop through the stats purchasable in the shop, 
        //But it shouldn't be too difficult to add other things like chat tag, 
        //tree type, etc.
        for(line iconKey of namespace.getKeys(statShopIcon)) {
            
            //Each hash entry has three parts, its ID tag, the pretty print name, and it's value
            //We can use this to easily search for stats with it's tag, display them nicely, 
            //and actually figure out how much of each thing there is. 
            line hashEntry:{"tag": str, "name": str, "amount": num} = {
                "tag": statShopIcon[iconKey].stat,
                "name": statShopIcon[iconKey].name,
                "amount": stats[statShopIcon[iconKey].stat]
            };

            stathash.append(hashEntry);
            
        }

        
        declare global "%uuid statHash":list[{"tag": str, "name": str, "amount": num}] = stathash;
    }


    function openMenu() {
        line inv = inventory.tiledMenu(3);

        select reset;

        //Stats that have been active since the game release
        line stat1 = item("oak_sapling");
        line treeLvl = global "%uuid stats"["tree_type"];
        line chatWins = saved "%uuid chat_wins";
        line donations = saved "%uuid donatedToWeatherMachine";
        line trueLogs = saved "%uuid true_logs";
        line playtime = util.timeFormat((saved "%uuid playtime") / 20, "HH:mm:ss");
        stat1 = stat1.setName(s"<green>Tracking Since release");
        stat1 = stat1.addLore(s"<gray>Current tree level: <white>%var(treeLvl)");
        stat1 = stat1.addLore(s"<gray>Total chat wins: <white>%var(chatWins)");
        stat1 = stat1.addLore(s"<gray>Total donated to the weather machine: <white>%var(donations)");
        stat1 = stat1.addLore(s"<gray>True logs cut: <white>%var(trueLogs)");
        stat1 = stat1.addLore(s"<gray>Total playtime: <white>%var(playtime)");
        inv.setItem(12, stat1);

        line stat2 = item("clock");
        line timber = saved "%uuid timberCount";
        line cumulative = saved "%uuid cumulativeLogs";
        line trinketcost = saved "%uuid totalTrinketCost";
        stat2 = stat2.setName(s"<green>Tracking Since Sep 20th, 2026");
        stat2 = stat2.addLore(s"<grey>Total Trees Timbered: <white>%var(timber)");
        stat2 = stat2.addLore(s"<grey>Cumulative Logs: <white>%var(cumulative)");
        stat2 = stat2.addLore(s"<grey>Total Trinkets Cost: <white>%var(trinketcost)");
        inv.setItem(14, stat2);


        statsMenu.computeStats();

        line stat3 = item("potato");
        stat3 = stat3.setModel("minecraft:iron_axe");
        stat3 = stat3.clearAttributes();
        stat3 = stat3.setLore();
        stat3 = stat3.setName(s"<green>Upgrade Stats");
        line stats =  global "%uuid stats"; 
        //stats var has all of the personal values but doesn't have the pretty names 
        //so we're going to use statShopIcon to get the nice names, then figure out the corresponding value in stats
        //this will mean all further stats will get added automatically
        for(line entry of global "%uuid statHash") {
            line name = entry["name"];
            line amount = entry["amount"];
            stat3 = stat3.addLore(s"<grey>%var(name): <white>%var(amount)");
        }
        inv.setItem(16, stat3);

        inv.openForSelection();
    }
}
import stats;
import util;
import abils;

playerevent chat {
    // currently only contains DropExitJoin
    if(event.message == "67") {
        allPlayers.sendMessage("<dark_gray>%default Tried saying 67, But we banned it. <dark_red>L");
        event.cancel();
    }
    if(global chatGameSolution.len() != 0 && event.message.matches(global chatGameSolution, ignoreCase = "True")) {
        allPlayers.sendMessage(s"<green><bold>WINNER! <reset><aqua>%default <gray>got the answer of %var(chatGameSolution)!");
        line logValue = log_families[num.floor(global "%uuid stats"["tree_type"]/5)+1]["value"];
        line logInc = logValue * ((num.floor(global "%uuid stats"["tree_type"]%5)+1) * 225);
        if(global "%uuid stats"["tree_type"] >= 55) {
            line logInc = logValue * (6 * 225);
        }
        if(global "%uuid stats"["tree_type"] >= 60) {
            line logInc *= 2;
        }
        if(global "%uuid stats"["tree_type"] >= 65) {
            line logInc *= 2;
        }
        if(global "%uuid stats"["tree_type"] >= 70) {
            line logInc *= 2;
        }
        if(global "%uuid stats"["tree_type"] >= 85) {
            line logInc *= 2;
        }
        if(global "%uuid stats"["tree_type"] >= 80) {
            line logInc *= 1.5;
        }
        if(global "%uuid stats"["tree_type"] >= 85) {
            line logInc *= 1.5;
        }
        if(global "%uuid stats"["tree_type"] >= 90) {
            line logInc *= 1.5;
        }
        if(global "%uuid stats"["tree_type"] >= 100) {
            line logInc *= 1.5;
        }

        line logRender = util.numberFormat(logInc);
        allPlayers.sendMessage(s"<dark_gray>The person earned %var(logRender) logs!");
        chatGameSolution = "";
        saved "%uuid logs" += logInc;
        declare global hintType: num = 0;
        declare saved "%uuid chat_wins": num += 1;
    }
    // exclusively for the number guessing game
    if(global hintType == 1) {
        line realVal = num.parse(chatGameSolution);
        line checkVal = num.parse(event.message);
        if(checkVal != 0) {
            event.cancel();
            if(checkVal < realVal) {
                player.sendMessage(s"<gray>The guess %var(checkVal) is too small.");
            } else {
                player.sendMessage(s"<gray>The guess %var(checkVal) is too big.");
            }
        }
    }
    
    // meow check from the did you know message
    if(num.random(1, 100000000, rounding = "Whole number") == 1 && event.message.startsWith("meow", ignoreCase = "True")) {
        allPlayers.sendMessage(s"<green><bold>%default GOT THE BILLION LOGS!");
        saved "%uuid logs" += 1_000_000_000;
    }
}

import stocksMenu;
import loops;
import weather;

namespace loops {
    // the master loop running everything on tick
    // really should not be edited as hotreloading this loop while in-game
    // causes lagslays
    process executePlayerLoops() {
        repeat {
            generalTickables();
            wait(1);
        }
    }

    // actual general every-tick game logic goes here
    function generalTickables() {
        declare saved gametime += 1;
        declare global sessiontime += 1;

        select allPlayers;
        start playerLoop(targetMode = "For each in selection");
        select reset;
        
        if(game.ticksSinceStartup % 1000 == 0) {
            loops.setupChatGame();
        }

        stocksMenu.tick();
        weather.tick();
    }

    // generates the data shown in the tab list
    function generateScoreboard() {
        if(game.timestamp - lastTime > 3) {
            declare global lastTime: num = game.timestamp;

            declare global tl = s"\n<green><bold>TREECUTTING<reset>\n\n\n";
            line players: dict[num] = {};
            line logs: dict[num] = {};
            for(line playerUuid of game.plotPlayerUUIDs) {
                select playersByName(playerUuid);
                players[selected.name.clearFormatting()] = global "%uuid stats"["tree_type"];
                logs[selected.name.clearFormatting()] = saved "%uuid logs";
                select reset;
            }

            // shows players in custom tab, sorted by level
            players = players.sort("type" = "Sort by Value", order = "Descending");
            for(line player, line level of players) {
                line lc = util.numberFormat(logs[player]);
                line tag = createChatTag(level);
                tl += s"%var(tag) <#dddddd>%var(player) <dark_gray>%var(lc)<reset>\n";
            }

            // general game data
            line cpu = game.cpuUsage * 100;
            line pc = game.playerCount;
            tl += s"\n<gray>Players Online: <aqua>%var(pc)\n";
            tl += s"<gray>CPU Usage: <green>%var(cpu)<dark_green>%\n";

            if(game.cpuUsage * 100 > 40) {
                tl += s"<red>LAG: Some visual effects have been disabled for performance.\n";
            }

            if(game.cpuUsage * 100 > 60) {
                tl += s"<red>LAG: Speed-based animations been slowed down for performance.\n";
            }

            // weather machine data
            tl += s"\n<aqua><bold>WEATHER MACHINE<reset>\n";
            if(weatherType == 0) {
                tl += s"<gray>Status: <red>Inactive\n";
            }
            if(weatherType == 1) {
                tl += s"<gray>Status: <aqua>Rain\n";
                tl += s"<gray>Global Boost: <green>+20%\n";
                tl += s"<gray>Cost: <red>-5k/s/p\n";
            }
            if(weatherType == 2) {
                tl += s"<gray>Status: <blue>Thunderstorm\n";
                tl += s"<gray>Global Boost: <green>+50%\n";
                tl += s"<gray>Cost: <red>-20k/s/p\n";
            }
            if(weatherType == 3) {
                tl += s"<gray>Status: <dark_red>Severe Thunderstorm\n";
                tl += s"<gray>Global Boost: <green>+90%\n";
                tl += s"<gray>Cost: <red>-40k/s/p\n";
            }
            if(weatherType == 4) {
                tl += s"<gray>Status: <dark_blue>Hurricane\n";
                tl += s"<gray>Global Boost: <green>+150%\n";
                tl += s"<gray>Cost: <red>-150k/s/p\n";
            }
            if(weatherType == 5) {
                tl += s"<gray>Status: <dark_gray>Tornado\n";
                tl += s"<gray>Global Boost: <green>+250%\n";
                tl += s"<gray>Cost: <red>-300k/s/p\n";
            }
            line fmt = util.numberFormat(weatherMachineLogs);
            tl += s"<gray>Logs: <green>%var(fmt)\n";

            tl = tl + s"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n";
            
            allPlayers.setTabListInfo(tl, field = "Header");
        }
    }

    // sends a random did you know message when called
    function didyouknow() {
        line tip: txt = var.setToRandom(
            s"You can Swap Hands to open your upgrade menu!",
            s"You can double jump mid-air, if you have a high enough Jump Boost!",
            s"The game is completely open-source at <click:open_url:'https://github.com/akarahdev/treecutters'>https://github.com/akarahdev/treecutters</click>",
            s"Calc is short for calculator, for those new to the stream.",
            s"Meowing gives you a 0.000001% chance to instantly get a billion logs.",
            s"We have a discord at <click:open_url:'https://discord.gg/DHEYJB9UX3'>https://discord.gg/DHEYJB9UX3</click>."
        );
        select playersByCondition(saved "%uuid settings"["helpfulTips"] == "Enabled");
        selected.sendMessage(s"<gold><bold>DID YOU KNOW? <reset><gray>%var(tip)");
        select reset;
    }
    
    // general loop data for each player
    process playerLoop() {
        // combo management
        global "%uuid combo": num *= 0.99;
        global "%uuid combo" = global "%uuid combo".round();

        if(global "%uuid combo" < 0) {
            global "%uuid combo" = 0;
        }

        if(global "%uuid combo" >= 2500) {
            global "%uuid combo" = 2500;
        }

        if(global "%uuid stats"["combo_str"] > 0) {
            player.setBossBar(
                s"<blue>Combo: %var(%uuid combo)",
                global "%uuid combo",
                2500,
                1
            );
        }

        // general counters
        declare saved "%uuid playtime" += 1;
        if(game.ticksSinceStartup % (60 * 20) == 0 && game.plotPlayerUUIDs[1] == player.uuid) {
            didyouknow();
        }

        // logs per second counter
        if(game.ticksSinceStartup % 20 == 19) {
            if(!var.exists(global "%default logHistory")) {
                declare global "%default logHistory": list[num] = [];
            }
            declare global "%default currLogs": num = saved "%uuid logs";
            line diff = global "%default currLogs" - global "%default lastLogs";
            line fmt = util.numberFormat(diff);
            declare global "%default logSecComp": txt = s"<#CC9F8E>+%var(fmt)/s";
        }
        if(game.ticksSinceStartup % 20 == 0) {
            declare global "%default lastLogs": num = saved "%uuid logs";
        }
        // send actionbar and tablist every 5 ticks
        // hashCode is to distribute the computation to prevent high cpu
        if(game.ticksSinceStartup % 5 == global "%uuid hashCode" % 5) {
            line brokenSoFar = global "%uuid brokenLogs".len();
            line brokenReq = global "%uuid blocksToBreak".len();
            line totalPerc = ((brokenSoFar / (brokenReq * (0.9 - global "%uuid stats"["cutoff_rate"]))) * 100).round().min(100);
            line fmtLogs = util.numberFormat(saved "%uuid logs");

            line components: list[txt] = [];
            // colors by GodwolfGaming100
            components.append(s"<#996947>╟ <#FFC09E>%var(fmtLogs) Logs");

            if(global "%default logSecComp" != 0 && saved "%uuid settings"["logSecActionBar"] == "Enabled") {
                components.append(global "%default logSecComp");
            }

            if(saved "%uuid stockCount" >= 1) {
                line fmt = util.numberFormat(saved stockValue);
                components.append(s"<#cccccc>Stock Price: <#00fff00>%var(fmt)");
            }

            components.append(s"<gray>%var(totalPerc)%");

            


            line bar = components.joinStyled(s" <dark_gray>| ");

            player.sendActionBar(bar);


            
            generateScoreboard();

            if(game.locationIsInBlock(player.location) && game.locationIsInBlock(player.eyeLocation)) {
                player.teleport(player.location.shiftAllAxes(0, 2, 0));
            }

            if(player.isStandingOnBlock(item("light_blue_stained_glass"))) {
                player.teleport(global "%uuid roomPos".shiftAllAxes(6, 6, 6));
            }

            if(player.location.y < 0) {
                player.teleport(
                    (global "%uuid roomPos").shiftAllAxes(-6, 3, -6)
                );
            }
        }


        // reset double jumps
        if(player.isGrounded()) {
            global "%uuid canDoubleJump" = 1 + (global "%uuid stats")["triple_jumps"]; 
        }

        // set up the player's visual and client effects
        if(game.ticksSinceStartup % 20 == global "%uuid hashCode" % 20) {
            player.givePotionEffect(pot("Night Vision", 1, 100000), particles = "None", showIcon = "False");

            player.setSaturationLevel(20);
            player.setFoodLevel(20);

            player.setNameTagVisible(visible = "Enable");
            line lv = global "%uuid stats"["tree_type"];
            player.setChatTag(createChatTag(lv));
            player.setChatStyle(s"<#dddddd>");

            updatePlayerInv();
        }
        abils.turret();
    }

    function createChatTag(level: num): txt {
        line color = "gray";
        if(level >= 4) {
            color = "blue";
        }
        if(level >= 9) {
            color = "green";
        }
        if(level >= 14) {
            color = "yellow";
        }
        if(level >= 19) {
            color = "gold";
        }
        if(level >= 24) {
            color = "red";
        }
        if(level >= 29) {
            color = "dark_red";
        }
        if(level >= 34) {
            color = "dark_purple";
        }
        if(level >= 39) {
            color = "light_purple";
        }
        if(level >= 44) {
            color = "aqua";
        }
        if(level > 49) {
            color = "gradient:#777777:#ffffff";
        }
        if(level > 54) {
            color = "gradient:blue:aqua";
        }
        if(level > 59) {
            color = "gradient:#000099:#0000ff";
        }
        if(level > 64) {
            color = "gradient:#990099:#ff00ff";
        }
        if(level > 69) {
            color = "gradient:#660066:#cc00cc";
        }
        if(level > 74) {
            color = "gradient:#333399:#7777ff";
        }
        if(level > 79) {
            color = "gradient:#000066:#0000ff";
        }
        if(level > 84) {
            color = "gradient:#440044:#770077";
        }
        if(level > 89) {
            color = "gradient:#770077:#bb00bb";
        }
        if(level > 99) {
            color = "gradient:#5555c4:#c5d2e9";
        }
        if(level > 104) {
            color = "gradient:#FF218C:#FFD800";
        }
        if(level > 109) {
            color = "gradient:#5BCEFA:#F5A9B8";
        }
        return txt.parseExpression("<dark_gray>[<%var(color)>%var(level)🪓<dark_gray>]");
    }

    

    

    function updatePlayerInv() {
        line logs = saved "%uuid logs";

        if(game.cpuUsage * 100 > 30) {
            logs = 0;
        }

        line basicLogs = (logs % 64);
        line enchLogs = ((logs / 64) % 64);
        line hyperEnchLogs = ((logs / 64 / 64) % 64);
        line hyperEnch2Logs = ((logs / 64 / 64 / 64) % 64);
        line hyperEnch3Logs = ((logs / 64 / 64 / 64 / 64) % 64);
        line hyperEnch4Logs = ((logs / 64 / 64 / 64 / 64 / 64) % 64);

        line basicLogItem = item("stripped_oak_wood", basicLogs);
        basicLogItem = basicLogItem.setName(s"");
        basicLogItem = basicLogItem.setTooltipVisible(tooltip = "Disable");

        line enchLogItem = item("stripped_oak_wood", enchLogs);
        enchLogItem = enchLogItem.setHiddenComponents("enchantments");
        enchLogItem = enchLogItem.addEnchant("sharpness", 1);
        enchLogItem = enchLogItem.setName(s"");
        enchLogItem = enchLogItem.setTooltipVisible(tooltip = "Disable");

        line hyperEnchLogItem = item("stripped_spruce_wood", hyperEnchLogs);
        hyperEnchLogItem = hyperEnchLogItem.setHiddenComponents("enchantments");
        hyperEnchLogItem = hyperEnchLogItem.addEnchant("sharpness", 1);
        hyperEnchLogItem = hyperEnchLogItem.setName(s"");
        hyperEnchLogItem = hyperEnchLogItem.setTooltipVisible(tooltip = "Disable");


        line hyperEnch2LogItem = item("stripped_cherry_wood", hyperEnch2Logs);
        hyperEnch2LogItem = hyperEnch2LogItem.setHiddenComponents("enchantments");
        hyperEnch2LogItem = hyperEnch2LogItem.addEnchant("sharpness", 1);
        hyperEnch2LogItem = hyperEnch2LogItem.setName(s"");
        hyperEnch2LogItem = hyperEnch2LogItem.setTooltipVisible(tooltip = "Disable");


        line hyperEnch3LogItem = item("stripped_warped_stem", hyperEnch3Logs);
        hyperEnch3LogItem = hyperEnch3LogItem.setHiddenComponents("enchantments");
        hyperEnch3LogItem = hyperEnch3LogItem.addEnchant("sharpness", 1);
        hyperEnch3LogItem = hyperEnch3LogItem.setName(s"");
        hyperEnch3LogItem = hyperEnch3LogItem.setTooltipVisible(tooltip = "Disable");


        line hyperEnch4LogItem = item("stripped_crimson_stem", hyperEnch4Logs);
        hyperEnch4LogItem = hyperEnch4LogItem.setHiddenComponents("enchantments");
        hyperEnch4LogItem = hyperEnch4LogItem.addEnchant("sharpness", 1);
        hyperEnch4LogItem = hyperEnch4LogItem.setName(s"");
        hyperEnch4LogItem = hyperEnch4LogItem.setTooltipVisible(tooltip = "Disable");

        for(line r of range(2, 9)) {
            player.setItemInSlot("air" as item, r);
        }
        line slot = 2;
        if(hyperEnch4Logs > 1) {
            player.setItemInSlot(hyperEnch4LogItem, slot);
            slot++;
        }
        if(hyperEnch3Logs > 1) {
            player.setItemInSlot(hyperEnch3LogItem, slot);
            slot++;
        }
        if(hyperEnch2Logs > 1) {
            player.setItemInSlot(hyperEnch2LogItem, slot);
            slot++;
        }
        if(hyperEnchLogs > 1) {
            player.setItemInSlot(hyperEnchLogItem, slot);
            slot++;
        }
        if(enchLogs > 1) {
            player.setItemInSlot(enchLogItem, slot);
            slot++;
        }
        if(basicLogs > 1) {
            player.setItemInSlot(basicLogItem, slot);
            slot++;
        }
    }
}
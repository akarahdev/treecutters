namespace chatLoops {
    // leader function executing in the global loop
    // to make sure the chat game can actually be ran
    function setupChatGame() {
        if(game.ticksSinceStartup % 3000 != 0) {
            global ChatGamesTimer--;
            return;
        } else {
            global ChatGamesTimer = 3000;
        }
        if(game.playerCount < 3) {
            return;
        }
        setupChatGameHidden();
    }

    // actually runs the chat game
    function setupChatGameHidden(gameType = 0) {
        declare global chatGameSolutions: list[str] = [];
        declare global ChatGamesTimer:num = 0;

        if(gameType == 0) {
            gameType = num.random(1, 5, rounding = "Whole number");
        }

        // the leading part, e.g QUICK MATH!
        line gameTypeTxt: str = "";
        // the actual question the players must answer
        line gamePrompt: str = "";
        
        if(gameType == 1) {
            gameTypeTxt = "QUICK MATH!";

            line a = num.random(2, 20, rounding = "Whole number");
            line b = num.random(2, 20, rounding = "Whole number");
            line c = num.random(2, 20, rounding = "Whole number");
            
            line equationType = num.random(1, 3, rounding = "Whole number");
            if(equationType == 1) {
                chatGameSolutions.append(str.setToString(a + b * c));
                gamePrompt = "%var(a) + %var(b) * %var(c)";
            } else if(equationType == 2) {
                chatGameSolutions.append(str.setToString(a * b * c));
                gamePrompt = "%var(a) * %var(b) * %var(c)";
            } else if(equationType == 3) {
                chatGameSolutions.append(str.setToString(a * b - c));
                gamePrompt = "%var(a) * %var(b) - %var(c)";
            }
            if(chatGameSolutions.contains("67")) {
                setupChatGameHidden();
                return;
            }
            gamePrompt = "Solve %var(gamePrompt).";
        }
        if(gameType == 3) {
            chatGameSolutions.append(str.setToString(num.random(1, 200, rounding = "Whole number")));
            if(chatGameSolutions.contains("67")) {
                setupChatGameHidden();
                return;
            }
            gameTypeTxt = "GUESS THE NUMBER!";
            gamePrompt = "A number from 1 to 200 has been selected. Guess it!";
            global hintType = 1;
        }
        if(gameType == 4) {
            line syllogies: dict[list[str]] = {
                "DF": ["DiamondFire"],
                "HTML": ["Hypertext Markup Language"],
                "6!": ["720"],
                "6!!": ["48"], // double factorial
                "6!!!": ["18"], // triple factorial
                "meow": ["meow"],
                "LASER": ["Light Amplification by Stimulated Emission of Radiation"],
                "CEO": ["Chief Executive Officer"],
                "All humans are mortal. Aristotle is human, therefore...": ["Aristotle is mortal"],
                "The cat is either gray or black. The cat is gray, therefore...": ["the cat is not black"],
                "If it rains, the grass gets wet. It is raining, therefore...": ["the grass is wet"],
                "(-b ± (sqrt(b^2-4ac)/(2a))": ["quadratic formula","quadratic equation"],
                "y = (-q / 2 + sqrt(q^2 / 4 + p^3 / 27))^(1/3) + (-q / 2 - sqrt(q^2 / 4 + p^3 / 27))^(1/3)": ["cubic formula","cubic equation"],
                "x = [ -(b ± sqrt(b^2 - 4ac + 4ay)) ± sqrt( (b ± sqrt(b^2 - 4ac + 4ay))^2 - 8ay ± [16a^2d - 8aby]/sqrt(b^2 - 4ac + 4ay) ) ] / (4a)": ["quartic formula", "quartic equation"],
                "Who created this dopamine rush?": ["Endistic"],
                "SMotS": ["Scattered Mirror of the Storm"],
                "mb6fbhsphdrcb": ["Roboboost","moving block 6-frame bunnyhop subpixel hyperdash reverse cornerboost"]
            };
            line rng = var.setToRandom(syllogies.getKeys()) as str;
            gameTypeTxt = "SYLLOGISM!";
            gamePrompt = "What is `%var(rng)`?";
            chatGameSolutions.appendList(syllogies[rng]);
            print(chatGameSolutions[chatGameSolutions.len() - 1]);
        }
        if(gameType == 5) {
            line syllogies: dict[list[str]] = {
                "What has a face, but can't smile?": ["Clock"],
                "What has many keys, but can't open a single lock?": ["Piano"],
                "What lives if you feed it, but dies if you give it a drink?": ["Fire"],
                "What has a head and a tail, but no body?": ["Coin"],
                "What can you catch, but not throw?": ["A cold"],
                "What sound does an itty bitty cute little kitty cat make?": ["meow","purr","mew","nya","mrrp","mrrow","I'm a cat"]
            };
            line rng = var.setToRandom(syllogies.getKeys()) as str;
            gameTypeTxt = "RIDDLE!";
            gamePrompt = "%var(rng)";
            chatGameSolutions.appendList(syllogies[rng]);
            print(chatGameSolutions[chatGameSolutions.len() - 1]);
        }
        if(gameType == 2) {
            line words: list[str] = [
                "apple",
                "almond",
                "aspen",
                "baobab",
                "waxed lightly weathered cut copper stairs",
                "birch",
                "bodhi",
                "bark",
                "cedar",
                "cherry",
                "coconut",
                "chestnut",
                "elderberry",
                "fir",
                "forest",
                "grove",
                "grapefruit",
                "haw",
                "holly",
                "jungle",
                "maple",
                "nectarine",
                "oak",
                "palm",
                "rainforest",
                "rubber",
                "spruce",
                "walnut",
                "willow",
                "olive",
                "sprout",
                "sprouting",
                "flower",
                "flowering",
                "birches",
                "felled",
                "chopped",
                "cut",
                "treecutting",
                "bonsai",
                "shrubs",
                "arboreal",
                "evergreen",
                "poplars",
                "leafless",
                "cedars",
                "grapevines",
                "deciduous",
                "undergrowth",
                "eucalyptus",
                "persimmon",
                "pines",
                "bushes",
                "fruit",
                "pruned",
                "mango",
                "dwarfed",
                "trunks",
                "leaves",
                "kasane teto",
                "hatsune miku",
                "kagamine rin",
                "kagamine len",
                "adachi rei",
                "jeremaster"
            ];
            line sel = words[num.random(1, words.len() - 1, rounding = "Whole number")];
            line scrambled: list[str] = sel.split("");
            for(line i of range(1, 20)) {
                line char1 = num.random(1, sel.len());
                line char2 = num.random(1, sel.len());
                line tmp1 = scrambled[char1];
                line tmp2 = scrambled[char2];
                scrambled[char1] = tmp2;
                scrambled[char2] = tmp1;
            }
            line outstr = scrambled.join("");
            gameTypeTxt = "QUICK SCRAMBLE!";
            gamePrompt = "Unscramble the word '%var(outstr)'!";
            chatGameSolutions.append(sel);
        }
        allPlayers.sendMessage(s"<green><bold>%var(gameTypeTxt) <reset><gray>%var(gamePrompt)");
    }
}
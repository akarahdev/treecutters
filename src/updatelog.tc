import update;

namespace update {
    schema: namespace {
        date: str;
        changes: list[str];
    };
}

namespace update.sep13 {
    date = "September 13th";
    changes: list[str] = ["+ Released the game!"];
}

namespace update.sep14 {
    date = "September 14th";
    changes: list[str] = ["+ Ran a birthday promo for +15% logs!", "+ Added the city", "+ Added a tree type level leaderboard", "+ Added Turret upgrade"];
}

namespace update.sep15 {
    date = "September 15th";
    changes: list[str] = ["+ Added stock market", "+ Added settings menu"];
}

namespace update.sep16 {
    date = "September 16th";
    changes: list[str] = ["+ Added weather machine", "+ Added logs per second counter", "+ Added optional double jump settings", "+ Added triple jump and timber upgrades"];
}

namespace update.sep17th {
    date = "September 17th";
    changes: list[str] = ["+ Added Level 55+ tree types", "+ Improved throwing axe mechanics", "+ Fixed issues involving entities not despawning", "+ Added update logs", "+ Added combo system", "+ Buffs are now additive", "+ Level cap is now 105"];
}

namespace update.sep18th {
    date = "September 18th";
    changes: list[str] = ["+ Optimized certain visual effects"];
}

namespace update.sep19th {
    date = "September 19th";
    changes: list[str] = ["+ Added trinkets", "+ Added tree type levels 106-120", "+ Buffed Fortune from 6% -> 8%", "+ Added Supercell weather type"];
}

namespace update.sep20th {
    date = "September 20th";
    changes: list[str] = ["+ Buffed non-Helix trinkets", "+ Added Absolution trinket", "+ Adjusted stats and weights for every trinket", "+ Reduced global trinket exponent from 0.95 to 0.9"];
}

namespace updateMenu {
    function openMenu() {
        line inv = inventory.tiledMenu(4);

        line icon = item("diamond");

        icon = icon.setName(s"<aqua><bold>GitHub Contributors");
        icon = icon.addLore(s"<dark_gray>- <gold>Endistic");
        icon = icon.addLore(s"<dark_gray>- <gray>Froogile");
        icon = icon.addLore(s"<dark_gray>- <gray>yair0211");
        icon = icon.addLore(s"<dark_gray>- <gray>Barfl");
        icon = icon.addLore(s"<dark_gray>- <gray>Kenorbs");

        inv.setItem(32, icon);

        line slot = 1;
        for(line iconKey of namespace.getKeys(update)) {
            line date = update[iconKey].date;
            line changes = update[iconKey].changes;

            line icon = item("acacia_boat");
            icon = icon.setName(s"<green>%var(date)");
            for(line l of changes) {
                icon = icon.addLore(s"<gray>%var(l)");
            }

            inv.setItem(slot, icon);
            
            slot++;
        }

        inv.openForSelection();
    }
}


namespace util {
    // runs a wait every freq times
    // e.g 1/32 => every 32 executions, wait a tick
    function fastWait(freq: num) {
        line oftency = 1 / freq;
        local __fastWait: num;
        local __fastWait = local __fastWait + 1;
        if(game.cpuUsage * 100 > 60) {
            __fastWait += (oftency / 20);
        }
        if(__fastWait > oftency) {
            __fastWait = 0;
            wait(1);
        }
    }

    // formats a number to me in a comma-seperated format when rounded
    // e.g 1234.567 -> 1,234
    function numberFormat(value: num): str {
        line regex = "\\d{1,3}(?=(\\d{3})*$)";
        line captures = str.getAllRegexMatches(str.setToString(value.round()), regex);
        return captures.join(",");
    }

    // Formats a numbers to a format specified by the call
    // e.g 60 -> 01:00 (mm:ss)
    // e.g 3600 -> 01:00:00 (hh:mm:ss)
    function timeFormat(value: num, format: string): str {
        line result = str.formatTimestamp(value, format, format="Custom");
        return result;
    }
}

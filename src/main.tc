declare saved "%uuid logs": num;
declare global "%uuid brokenLogs": list[loc];

playerevent join {
    player.setToSurvivalMode();

    line tool = item("music_disc_cat");
    tool = tool.setModel("minecraft:iron_axe");
    tool = tool.addToolMiningRule(
        500,
        global woodTypeList
    );
    tool = tool.setTag("axe", 1);

    player.giveItems(item("birch_sapling"));
    player.giveItems(item("oak_sapling"));
    player.giveItems(item("spruce_sapling"), 64);
    player.giveItems(tool);
    player.enableBlockModification(
        global woodTypeList
    );
    // player.givePotionEffect(
    //     pot("Jump Boost", 4, 10000000),
    //     particles = "None",
    //     showIcon = "False"
    // );
    // player.givePotionEffect(
    //     pot("Speed", 7, 10000000),
    //     particles = "None",
    //     showIcon = "False"
    // );

    declare global "%uuid roomPos": loc = roomPositions.pop();
    if(global "%uuid roomPos" == 0) {
        player.kick();
    }

    player.teleport(
        (global "%uuid roomPos").shiftAllAxes(-6, 0, -6)
    );
    game.setRegion(
        "air" as item,
        global "%uuid roomPos".shiftAllAxes(-25, 0, -25),
        global "%uuid roomPos".shiftAllAxes(25, 30, 25)
    );
    start treegens.growForPlayer();

}

playerevent leave {
    global roomPositions.append(global "%uuid roomPos");
}

import loops;

gameevent startup {
    declare global woodTypeList: list[item] = [
        item("stripped_oak_wood")
    ];

    declare global roomPositions: list[loc] = [
        loc(25, 50, 25),
        loc(25, 50, 75),
        loc(75, 50, 25),
        loc(75, 50, 75)
    ];
    start loops.executePlayerLoops();
}

import treegens;
import sweeping;

playerevent breakBlock {
    if(!event.blockEquals(global woodTypeList)) {
        event.cancel();
        endthread;
    }
    line blocks = sweeping.getBlockOrders(
        event.blockLocation,
        0
    );
    sweeping.safeBreak(event.blockLocation);
    sweeping.executeSweep(saved "%uuid logs", blocks);
}

playerevent placeBlock {
    event.uncancel();
    if(event.blockEquals(item("birch_sapling"))) {
        treegens.buildOakTree(
            event.blockLocation,
            treegens.tiny
        );
    }
    if(event.blockEquals(item("oak_sapling"))) {
        treegens.buildOakTree(
            event.blockLocation,
            treegens.small
        );
    }
    if(event.blockEquals(item("spruce_sapling"))) {
        treegens.buildOakTree(
            event.blockLocation,
            treegens.big
        );
    }
}

import throwingaxe;

playerevent rightClick {
    if(player.mainHandItem.getTag("axe") != 0) {
        line p = player.eyeLocation;
        p.shiftInDirection(0.25);
        start throwingaxe.throw(p);
    }
}
declare saved "%uuid logs": num;
declare global "%uuid brokenLogs": list[loc];

import stats;
import settingsMenu;

playerevent join {

    player.setAllowHandCrafting(allow = "Disable");
    // types of wood that the player can break
    declare global woodTypeList: list[item] = [
        item("stripped_oak_wood"),
        item("stripped_spruce_wood"),
        item("stripped_cherry_wood"),
        item("stripped_warped_stem"),
        item("stripped_crimson_stem"),
        item("stripped_pale_oak_wood"),
        item("pale_oak_wood"),
        item("stripped_birch_wood"),
        item("stripped_dark_oak_wood"),
        item("oak_wood"),
        item("stripped_acacia_wood")
    ];

    namespace.reload();

    for(line p of game.plotPlayerUUIDs) {
        select playersByName(p);
        stats.computeStats();
        select reset;
    }

    if (saved "%uuid timberCount" == 0) {
        declare saved "%uuid timberCount":num = 0;
    }
    

    settingsMenu.initJoin();

    // types of trees in the game
    // log families are responsible for the toughness, the log value,
    // and the in-game naming
    declare global log_families: list[log_family] = [
        log_family(1, 0, "Oak"),
        log_family(3, 6, "Darkwood"),
        log_family(15, 12, "Cherry"),
        log_family(30, 16, "Warped"),
        log_family(60, 20, "Molten"),
        log_family(100, 24, "Aerial"),
        log_family(240, 28, "Lunar"),
        log_family(480, 32, "Solar"),
        log_family(600, 36, "Astral"),
        log_family(900, 40, "Yggdrasil"),
        log_family(1200, 45, "Infinitum I"),
        log_family(1300, 45, "Infinitum II"),
        log_family(1400, 45, "Infinitum III"),
        log_family(1500, 45, "Infinitum IV"),
        log_family(1600, 45, "Infinitum V"),
        log_family(1700, 45, "Infinitum VI"),
        log_family(1800, 45, "Infinitum VII"),
        log_family(1900, 45, "Infinitum VIII"),
        log_family(2000, 45, "Infinitum IX"),
        log_family(2100, 45, "Infinitum X"),
        log_family(2200, 45, "Infinitum XI"),
        log_family(2300, 45, "Infinitum XII"),
        log_family(2400, 45, "Infinitum XIII"),
        log_family(2500, 45, "Infinitum XIV"),
        log_family(2600, 45, "Infinitum XV"),
        log_family(2700, 45, "Infinitum XVI")
    ];

    declare saved "%uuid statShop": dict[num];
    declare global "%uuid stats": dict[num] = {};

    global "%uuid treeRegenerating" = 0;

    player.setToSurvivalMode();

    line tool = item("potato");
    tool = tool.setModel("minecraft:iron_axe");
    tool = tool.addToolMiningRule(
        1000,
        global woodTypeList
    );
    tool = tool.setTag("axe", 1);
    tool = tool.setName(s"🪓 Axe");
    player.giveItems(tool);
    player.enableBlockModification(
        global woodTypeList
    );

    // tries to allocate a room for the player, kicks them for palyer limit if not available
    declare global "%uuid hashCode": num = num.random(0, 2147000000, rounding = "Whole number");
    declare global "%uuid roomPos": loc = roomPositions.pop();
    if(global "%uuid roomPos" == 0) {
        player.kick();
    }

    player.teleport(
        (global "%uuid roomPos").shiftAllAxes(-6, 3, -6)
    );

    

    game.cloneRegion(
        loc(0, 3, 0),
        loc(50, 38, 50),
        loc(0, 3, 0),
        global "%uuid roomPos".shiftAllAxes(-25, -3, -25),
        ignoreAir = "False"
    );



    start treegens.growForPlayer();



    stats.computeStats();
    
    wait(20);

    trinketOwnershipMenu.placeForPlayer();

    wait(40);


    player.sendMessage(s"");
    player.sendMessage(s"");
    player.sendMessage(s"<green>Welcome to Treecutting!");
    player.sendMessage(s"<dark_gray>- <gray>Swap Hands to open your upgrade menu.");
    player.sendMessage(s"<dark_gray>- <gray>Right Click to throw your axe.");
    player.sendMessage(s"<dark_gray>- <gray>You can double jump mid-air.");
    player.sendMessage(s"<yellow>Enjoy!");
    player.sendMessage(s"");
    player.sendMessage(s"");
    player.playSound(snd("Pling"));
}

playerevent leave {
    global roomPositions.append(global "%uuid roomPos");

    
    for(line thing of global "%uuid trailBeams") {
        select entitiesByUUID(thing["uuid"]);
        selectedEntity.remove();
        select reset;
    }

    for(line thing of global "%uuid fallingBlocks") {
        select entitiesByUUID(thing["uuid"]);
        selectedEntity.remove();
        select reset;
    }

    select entitiesByCondition(selectedEntity.hasTag("owner", "%default"));
    selectedEntity.remove();
    select reset;
}

import loops;

gameevent startup {
    stocksMenu.init();
    startup();
}

gameevent lagSlayRecover {
    start loops.executePlayerLoops();
}

function startup() {

    declare global trinketPositions: list[vec] = [
        vec(20.5, 4.5, 20.5), 
        vec(-19.5, 4.5, 20.5), 
        vec(-19.5, 4.5, -19.5), 
        vec(20.5, 4.5, -19.5)
    ];

    declare global sweepVecs: list[vec] = [
        vec(-1, -1, -1), vec(-1, -1, 0), vec(-1, -1, 1),
        vec(-1, 0, -1),  vec(-1, 0, 0),  vec(-1, 0, 1),
        vec(-1, 1, -1),   vec(-1, 1, 0),   vec(-1, 1, 1),
        vec(0, -1, -1),   vec(0, -1, 0),   vec(0, -1, 1),
        vec(0, 0, -1),                     vec(0, 0, 1),
        vec(0, 1, -1),    vec(0, 1, 0),    vec(0, 1, 1),
        vec(1, -1, -1),   vec(1, -1, 0),   vec(1, -1, 1),
        vec(1, 0, -1),    vec(1, 0, 0),    vec(1, 0, 1),
        vec(1, 1, -1),    vec(1, 1, 0),    vec(1, 1, 1)
    ];

    declare global roomPositions: list[loc] = [];

    setupPositions();

    start loops.executePlayerLoops();
}

function setupPositions() {
    for(line x of range(25, 250, 70)) {
        for(line z of range(25, 250, 70)) {
            for(line y of range(35, 250-31, 70)) {
                line newLoc = loc(x, y, z);
                roomPositions.append(newLoc);
            }
        }
    }
    print(roomPositions.len());
    
}

import treegens;
import sweeping;
import statShopIcon;

lscancel playerevent breakBlock {
    if(!event.blockEquals(global woodTypeList)) {
        event.cancel();
        endthread;
    }
    line blocks = sweeping.getBlockOrders(
        (global "%uuid stats")["tree_type"],
        event.blockLocation,
        (global "%uuid stats")["sweep"],
        global "%uuid firstStrike",
        (global "%uuid stats")["timber"],
    );
    global "%uuid firstStrike" = 0;
    sweeping.safeBreak(event.blockLocation);
    sweeping.executeSweep(saved "%uuid logs", blocks);
}

lscancel playerevent placeBlock {
    event.cancel();
}

import throwingaxe;
import stocksMenu;
import weather;
import trinketOwnershipMenu;
import drill;

lscancel playerevent rightClick {
    event.cancel();
    drill.clicks();
    weather.donate();
    stocksMenu.clicks();
    if(event.blockEquals(item("lime_shulker_box"))) {
        declare global "%uuid targetShulkerVec": vec = vec.between(
            global "%uuid roomPos",
            event.blockLocation
        );
        declare global "%uuid targetShulkerPos": loc = event.blockLocation;
        trinketOwnershipMenu.openMenu();
    }
    if(player.mainHandItem.getTag("axe") != 0) {
        if(player.getItemCooldown(player.mainHandItem) != 0) {
            endthread;
        }
        line p = player.eyeLocation;
        p.shiftInDirection(0.25);
        start throwingaxe.throw(p);
        player.setItemCooldown(
            player.mainHandItem, 
            10 - (global "%uuid stats"["ability_cooldown"]) + (global "%uuid stats"["multishot"] * 5)
        );

        if(global "%uuid stats"["multishot"] > 0 && global "%uuid treeRegenerating" == 0 && (global "%uuid turretTimer" as num) > 0) {
            line diff = global "%uuid blocksToBreak";
            diff.removeValue(global "%uuid brokenLogs");

            for(line x of range(1, global "%uuid stats"["multishot"])) {
                wait(5);
                line rngBlock = var.setToRandom(diff) as loc;
                rngBlock = rngBlock.align(coords = "All coordinates", align = "Block center", rotation = "Remove rotation");
                rngBlock.y -= 0.3;
                start throwingaxe.throw(p, rngBlock);
            }
        }



    }
}

lscancel playerevent clickInventorySlot {
    event.cancel();
}

import statShop;

lscancel playerevent swapHands {
    event.cancel();
    statShop.openMenu();
}

playerevent closeInventory {
    global "%uuid openInventory" = 0 as inventory;
}

playerevent clickMenuSlot {
    if(event.item.hasTag("warp", "home")) {
        player.teleport(
            (global "%uuid roomPos").shiftAllAxes(-6, 3, -6)
        );
        player.closeInventory();
    }
    if(event.item.hasTag("warp", "city")) {
        player.teleport(
            loc(73.4768, 5, 54.5637, 1.86, -90.99)
        );
        player.closeInventory();
    }
    statShop.clickStatShopIcon();
    settingsMenu.click();
    trinketOwnershipMenu.clicks();
    trinketShopMenu.clicks();
    stats.computeStats();
}

lscancel playerevent takeDamage {
    event.cancel();
}



playerevent movementKeyChange {
    if(event.movementKeyEquals(action = "Just pressed", key = "Jump (Space)")) {
        if(global "%uuid canDoubleJump" <= 0) {
            endthread;
        }
        
        if(player.isGrounded()) {
            endthread;
        }

        player.launchUp(global "%uuid stats"["jump_height"] + 1, addToCurrentVel = "False");

        if(saved "%uuid settings"["jumpType"] == "Look-Based") {
            player.launchForward(9/5 * (global "%uuid stats"["jump_height"]) + 9/5, addToCurrentVel = "True");
        } else {
            line mv = getMoveDir(1);
            mv = mv.multiply(9/5 * (global "%uuid stats"["jump_height"]) + 9/5);
            mv = mv.multiply(0.15);
            player.setVelocity(mv, addToCurrentVel = "True");
        }

        declare global "%uuid canDoubleJump" -= 1;
    }
}

// code originally by Frostbqte, ported to terracotta
function getMoveDir(y: num = 0): vec {
    line move_dir = vec(0, 0, 0);
    if(player.isMovementKeyPressed(forward = "Pressed")) {
        move_dir += vec(0, 0, 1);
    }
    if(player.isMovementKeyPressed(backward = "Pressed")) {
        move_dir += vec(0, 0, -1);
    }
    if(player.isMovementKeyPressed(left = "Pressed")) {
        move_dir += vec(1, 0, 0);
    }
    if(player.isMovementKeyPressed(right = "Pressed")) {
        move_dir += vec(-1, 0, 0);
    }
    move_dir = move_dir.setLength(1);
    move_dir = move_dir.rotateAroundAxis(-player.yaw, axis = "Y", unit = "Degrees");
    move_dir = move_dir.rotateAroundAxis(-player.pitch, axis = "Z", unit = "Degrees");
    return move_dir;
}

import trinketShopMenu;
import statsMenu;

playerevent command {
    if(event.commandArgumentEquals("tphere", 1) && player.hasPlotPermission(permission = "Owner")) {
        line arg = event.commandArguments[2];
        select playersByName(arg);
        selected.teleport(default.location);
        select reset;
    }
    //I added this back for testing reasons, trinket page would have been impossible to test otherwise - Kenorbs
    if(event.commandArgumentEquals("reroll", 1) && player.hasPlotPermission(permission = "Developer")) {
        line arg = event.commandArguments[2];
        trinketShopMenu.rerollShop();
    }
    if(event.commandArgumentEquals("bc", 1) && player.hasPlotPermission(permission = "Whitelisted")) {
        line st = event.command.trim(4);        
        allPlayers.sendMessage(s"<strikethrough><dark_gray><space:40>");
        allPlayers.sendMessage(s"<green><bold>BROADCAST <reset><gray>(by %default)");
        allPlayers.sendMessage(txt.parseExpression(st));
        allPlayers.sendMessage(s"<strikethrough><dark_gray><space:40>");
        allPlayers.playSound(snd("Enchantment Table Use"));
    }
    if(event.commandArgumentEquals("discord", 1)) {
        player.sendMessage(s"<click:open_url:'https://discord.gg/DHEYJB9UX3'>https://discord.gg/DHEYJB9UX3</click>");
    }
    if(event.commandArgumentEquals("warp", 1)) {
        if(global "%uuid stats"["tree_type"] >= 25) {
            if(event.commandArgumentEquals("stocks", 2)) {
                player.teleport(loc(97.8883, 4, 44.4137, 0.45, -88.75));
            }
            if(event.commandArgumentEquals("home", 2)) {
                player.teleport((global "%uuid roomPos").shiftAllAxes(-6, 3, -6));
            }
        }
    }
    if(event.commandArgumentEquals("miku", 1) && player.nameEquals("Kenorbs")) {
        line mikuMessage = event.commandArguments;
        line mikuLevel = loops.createChatTag((global "%uuid stats" as dict[num])["tree_type"]);
        line toSend:str = "";

        line idx = 0;
        for(line message of mikuMessage) {
            if(idx > 0) {
                toSend = "%var(toSend) %var(message)";
            }
            idx++;
        }
        allPlayers.sendMessage(s"%var(mikuLevel)<aqua>Hatsune Miku<reset>:%var(toSend)");
    }
    if(event.commandArgumentEquals("axolotl", 1) && player.hasPlotPermission(permission = "Whitelisted")) {
        select playersByName("IHaveAqInMyName");
        game.spawnMob(item("axolotl_spawn_egg"), selected.location);
        select reset;
    }
    if(event.commandArgumentEquals("stocktime", 1) && player.hasPlotPermission(permission = "Owner")) {
        line fc = num.parse(event.commandArguments[2]);
        if(fc == 0) {
            fc = -1;
        }
        global lotteryTime = 0;
        stocksMenu.tick(fc);
    }
    if(event.commandArgumentEquals("analyzetree", 1)) {
        line p = event.commandArguments[2];
        select playersByName(p);
        line brokenLogs = global "%uuid brokenLogs";
        line blocksToBreak = global "%uuid blocksToBreak";
        select reset;
        player.sendMessage(brokenLogs.len());
        player.sendMessage(blocksToBreak.len());
    }
    if(event.commandArgumentEquals("city", 1) && global "%uuid stats"["tree_type"] >= 25) {
        player.teleport(
            loc(73.4768, 5, 54.5637, 1.86, -90.99)
        );
    }
    if(event.commandArgumentEquals("settings", 1)) {
        settingsMenu.openMenu();
    }
    if(event.commandArgumentEquals("stats", 1)) {
        statsMenu.openMenu();
    }
    if(event.commandArgumentEquals("profile", 1) || event.commandArgumentEquals("stats", 1)) {
        line p = event.commandArguments[2] as str;
        if(!game.hasPlayer(p)) {
            player.sendMessage(s"player isn't online :(");
            return;
        }
        if(p as num == 0) {
            p = "%default";
        }

        select playersByName(p);
        line uuid = selected.uuid;
        select reset;

        player.sendMessage(s"<green>%var(p)'s Stats:");
        line tag = loops.createChatTag((global "%var(uuid) stats" as dict[num])["tree_type"]);
        player.sendMessage(s"<dark_gray>- <gray>Tag: %var(tag)");
        for(line key, line level of ((saved "%var(uuid) statShop" as dict[num]))) {
            line name = statShopIcon[key].name;
            player.sendMessage(s"<dark_gray>- <gray>%var(name): <green>%var(level)");
            if(key == "treeType") {
                line logFamily = global log_families[num.floor(level / 5) + 1];
                player.sendMessage(s" <dark_gray> > <aqua>%entry(logFamily,name) <green>+%entry(logFamily,value) Logs");
            }
        }
    }
    if(event.commandArgumentEquals("didyouknow", 1) && player.hasPlotPermission(permission = "Owner")) {
        loops.didyouknow();
    }
    if(event.commandArgumentEquals("chat_game", 1) && player.hasPlotPermission(permission = "Owner")) {
        loops.setupChatGameHidden(num.parse(event.commandArguments[2]));
    }
    if(event.commandArgumentEquals("setstatshop", 1) && player.hasPlotPermission(permission = "Owner")) {
        line skill = event.commandArguments[2];
        line lv = num.parse(event.commandArguments[3]);
        saved "%uuid statShop"[skill] = lv;
    }


    if(event.commandArgumentEquals("grant_logs", 1) && player.hasPlotPermission(permission = "Owner")) {
        line playerName = event.commandArguments[2];
        line amount = num.parse(event.commandArguments[3].replace("_", ""));
        select playersByName(playerName);
        saved "%uuid logs" += amount;
        selected.sendMessage(s"You got granted %var(amount) logs.");
        select reset;
        player.sendMessage(s"Sent %var(playerName) %var(amount) logs");
    }
    // originally used for the automatic tree type value calculation
    // dropped in favor of manual calculations for lv 50+
    if(event.commandEquals("test_trees") && player.hasPlotPermission(permission = "Owner")) {
        line entries: list[num] = [];
        for(line i of range(0, 47)) {
            line avg = 0;
            for(line j of range(1, 10)) {
                game.cloneRegion(
                    loc(0, 3, 0),
                    loc(50, 38, 50),
                    loc(0, 3, 0),
                    global "%uuid roomPos".shiftAllAxes(-25, -3, -25),
                    ignoreAir = "False"
                );
                avg += treegens.growArbitraryTree(i).len();
            }
            print(avg);
            entries.append(avg / 10);
        }
        line entryTxt = "";
        for(line entry of entries) {
            entryTxt += line entry;
            entryTxt += ",";
        }
        player.sendMessage(
            txt.parseExpression("<click:copy_to_clipboard:\"%var(entryTxt)\">click to copy</click>", allowed = "Full")
        );
    }
    if(event.commandEquals("killall")) {
        allEntities.remove();
    }
}


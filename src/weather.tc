namespace weather {
    function tick() {
        declare saved weatherMachineLogs: num;
        declare global weatherType: num = 0;

        
        
        if(weatherMachineLogs > 3_000_000_000) {
            // multi-vortex supercell
            weatherMachineLogs -= (1_100_000 * game.playerCount)/20;
            weatherType = 8;
            if(game.ticksSinceStartup % 50 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            select allPlayers;
            selected.displayParticleEffect(
                par("Smoke", amount = 70, spreadHoriz = 16, spreadVert = 16, motion = vec(0, -3, -30), motionVariation = 0.05),
                selected.eyeLocation
            );
            select reset;
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 1_000_000_000) {
            // multi-vortex supercell
            weatherMachineLogs -= (800000 * game.playerCount)/20;
            weatherType = 7;
            if(game.ticksSinceStartup % 60 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            select allPlayers;
            selected.displayParticleEffect(
                par("Smoke", amount = 40, spreadHoriz = 16, spreadVert = 16, motion = vec(0, -3, -30), motionVariation = 0.05),
                selected.eyeLocation
            );
            select reset;
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 500_000_000) {
            // supercell
            weatherMachineLogs -= (400000 * game.playerCount)/20;
            weatherType = 6;
            if(game.ticksSinceStartup % 100 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            select allPlayers;
            selected.displayParticleEffect(
                par("Smoke", amount = 20, spreadHoriz = 16, spreadVert = 16, motion = vec(0, -3, -30), motionVariation = 0),
                selected.eyeLocation
            );
            select reset;
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 400_000_000) {
            // tornado
            weatherMachineLogs -= (300000 * game.playerCount)/20;
            weatherType = 5;
            if(game.ticksSinceStartup % 100 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            select allPlayers;
            selected.displayParticleEffect(
                par("Smoke", amount = 20, spreadHoriz = 16, spreadVert = 16, motion = vec(0, -2, -20), motionVariation = 0),
                selected.eyeLocation
            );
            select reset;
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 250_000_000) {
            // hurricane
            weatherMachineLogs -= (150000 * game.playerCount)/20;
            weatherType = 4;
            if(game.ticksSinceStartup % 100 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            select allPlayers;
            selected.displayParticleEffect(
                par("Falling Water", amount = 20, spreadHoriz = 12, spreadVert = 12),
                selected.eyeLocation
            );
            select reset;
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 100_000_000) {
            // severe thunderstorm
            weatherMachineLogs -= (40000 * game.playerCount)/20;
            weatherType = 3;
            if(game.ticksSinceStartup % 150 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 50_000_000) {
            // thunderstorm
            weatherMachineLogs -= (15000 * game.playerCount)/20;
            weatherType = 2;
            if(game.ticksSinceStartup % 300 == 1) {
                game.summonLightning(loc(101, 14, 62));
            }
            allPlayers.setWeather(weather = "Downfall");
        } else if(weatherMachineLogs > 10_000_000) {
            // rain
            weatherMachineLogs -= (5000 * game.playerCount)/20;
            weatherType = 1;
            allPlayers.setWeather(weather = "Downfall");
        } else {
            // inactive, no weather
            weatherType = 0;
            allPlayers.setWeather(weather = "Clear");
        }
    }

    function donate() {
        if(player.isLookingAtBlock(loc(101, 6, 62))) {
            line counts = 1;
            if(player.isSneaking()) {
                counts = 10;
            }
            if(saved "%uuid logs" >= counts * 1_000_000) {
                saved "%uuid logs" -= counts * 1_000_000;
                weatherMachineLogs += counts * 1_000_000;
                declare saved "%uuid donatedToWeatherMachine": num += counts * 1_000_000;
                player.playSound(snd("Chest Open"), source = "Blocks");
            } else {
                player.sendMessage(s"<gray>You need at least <green>1,000,000 <gray>logs to power the weather machine.");
                player.playSound(snd("Chest Locked"), source = "Blocks");
            }
        }
    }
}
import treegens;

namespace treegens {
    big = "big";
    small = "small";
    tiny = "tiny";

    process growForPlayer() {
        if(global "%uuid treeRegenerating" == 1) {
            endthread;
        } 

        declare global "%uuid treeRegenerating" = 1;
        player.launchUp(2);
        wait(1);
        player.launchTowardLocation(
            global "%uuid roomPos",
            -5
        );
        wait(20);

        global "%uuid brokenLogs" = [];
        declare global "%uuid blocksToBreak" = treegens.buildOakTree(
            global "%uuid roomPos",
            treegens.tiny
        );
        global "%uuid treeRegenerating" = 0;
    }

    function buildOakTree(
        root: loc,
        size: str
    ): list[loc] {
        line log_positions: list[vec];
        line height: num;
        line branchReqs: num;
        line outputPositions: list[loc] = [];
        if(size == tiny) {
            log_positions = [
                vec(0, 0, 0)
            ];
            height = num.random(5, 7);
            branchReqs = 2;
        }  
        if(size == small) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1)
            ];
            height = num.random(7, 11);
            branchReqs = 3;
        }
        if(size == big) {
            log_positions = [
                vec(0, 0, 0),
                vec(0, 0, 1),
                vec(1, 0, 0),
                vec(1, 0, 1),
                vec(1, 0, -1),
                vec(-1, 0, 1),
                vec(0, 0, -1),
                vec(-1, 0, 0),
                vec(-1, 0, -1)
            ];
            height = num.random(11, 14);
            branchReqs = 4;
        }   

        for(line i of range(0, height)) {
            for(line offset of log_positions) {
                line added = root.shiftOnVector(offset);
                game.setBlock(item("stripped_oak_wood"), added);
                outputPositions.append(added);
            }
            wait(1);
            root.y += 1;
        }

        root.y -= 1;
        line terminalLength = num.floor(height * 0.6);
        line iterations = 0;
        line branches = 0;
        repeat {
            wait(1);
            iterations++;
            if(iterations > 50) {
                break;
            }
            if(branches >= branchReqs) {
                break;
            }
            line yaw = num.random(0, 360);
            line pitch = num.random(-30, 30);
            line rootCopy = root.shiftAllDirections(0, 0, 0);
            rootCopy.pitch += pitch;
            rootCopy.yaw += yaw;
            line checkLoc = rootCopy.shiftInDirection(2, direction = "Forward");
            if(game.getBlockMaterial(checkLoc) != "air") {
                continue;
            }
            line targetLoc = rootCopy.shiftInDirection(terminalLength, direction = "Forward");   

            for(line pathPos of path(root, targetLoc, 0.25)) {
                line placed = 0;
                if(game.getBlockMaterial(pathPos) == "air") {
                    placed = 1;
                }
                game.setBlock(item("stripped_oak_wood"), pathPos);
                if(placed == 1) {
                    outputPositions.append(pathPos.align());
                    wait(1);
                }
            }
            branches++;

        }

        outputPositions.removeDuplicates();
        return outputPositions;
    }
}